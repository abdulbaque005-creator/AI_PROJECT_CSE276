# ─── Database ────────────────────────────────────────────
# Neon / Supabase / Local PostgreSQL connection string.
# In serverless environments, DATABASE_URL should use a pooled connection (e.g. Neon -pooler URL or Supabase port 6543).
DATABASE_URL="postgresql://user:password@localhost:5432/documind?schema=public"

# Direct unpooled connection string used exclusively by Prisma migrations (prisma migrate deploy).
# In local development without a connection pooler, set DIRECT_URL to match DATABASE_URL.
DIRECT_URL="postgresql://user:password@localhost:5432/documind?schema=public"

# ─── Authentication ──────────────────────────────────────
AUTH_SECRET="generate-a-random-secret-at-least-32-chars"
AUTH_URL="http://localhost:3000"

# Google OAuth (optional)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── AI Providers ────────────────────────────────────────
GOOGLE_GENERATIVE_AI_API_KEY="your-gemini-api-key"

# ─── Storage Configuration ───────────────────────────────
# Supported storage modes:
# - "local": Stores files on the local filesystem. Zero cloud credentials required.
#            NOTE: Local mode is non-durable on serverless platforms (e.g., Vercel, Netlify).
# - "s3":    Standard AWS S3 or MinIO S3-compatible storage.
# - "r2":    Cloudflare R2 (10 GB free tier, zero egress fees).
STORAGE_MODE="local"

# Local storage directory (only used when STORAGE_MODE="local")
LOCAL_STORAGE_DIR=".storage/documents"

# ─── Remote Object Storage (when STORAGE_MODE="s3" or "r2") ───
# Cloudflare R2 Zero-Budget Configuration Example:
#   STORAGE_MODE="r2"
#   S3_ENDPOINT="https://<cloudflare-account-id>.r2.cloudflarestorage.com"
#   S3_REGION="auto"
#   S3_ACCESS_KEY_ID="<r2-access-key-id>"
#   S3_SECRET_ACCESS_KEY="<r2-secret-access-key>"
#   S3_BUCKET_NAME="documind-production"
#   S3_FORCE_PATH_STYLE="false"
#
# AWS S3 Configuration Example:
#   STORAGE_MODE="s3"
#   S3_REGION="us-east-1"
#   S3_ACCESS_KEY_ID="<aws-access-key-id>"
#   S3_SECRET_ACCESS_KEY="<aws-secret-access-key>"
#   S3_BUCKET_NAME="documind-documents"
#   S3_FORCE_PATH_STYLE="false"
#
# MinIO Local Development Example:
#   STORAGE_MODE="s3"
#   S3_ENDPOINT="http://localhost:9000"
#   S3_REGION="us-east-1"
#   S3_ACCESS_KEY_ID="minioadmin"
#   S3_SECRET_ACCESS_KEY="minioadmin"
#   S3_BUCKET_NAME="documind"
#   S3_FORCE_PATH_STYLE="true"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET_NAME="documind"
S3_FORCE_PATH_STYLE="true"

# ─── Redis (BullMQ) ─────────────────────────────────────
# Redis is optional for zero-budget single-instance deployments.
# When unavailable, document processing gracefully falls back to synchronous execution.
REDIS_URL="redis://localhost:6379"

# ─── Application ─────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
